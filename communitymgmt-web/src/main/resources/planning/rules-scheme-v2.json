{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Planning Rules Schema",
  "type": "object",
  "required": ["rules"],
  "properties": {
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/rule"
      }
    }
  },
  "definitions": {

    "rule": {
      "type": "object",
      "required": ["id", "name", "scope", "conditions", "effect"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "name": {
          "type": "string"
        },
        "scope": {
          "$ref": "#/definitions/scope"
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/condition"
          }
        },
        "effect": {
          "$ref": "#/definitions/effect"
        }
      }
    },

    "scope": {
      "type": "object",
      "required": ["celebrations"],
      "properties": {
        "celebrations": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["WORD", "LITURGY", "COMMUNITY"]
          },
          "minItems": 1
        }
      }
    },

    "condition": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "WEEK_OF",
            "FIXED_DATE",
            "DATE_RANGE",
            "WEEKDAY",
            "HOLIDAY"
          ]
        },
        "value": {
          "oneOf": [
            { "$ref": "#/definitions/weekOfCondition" },
            { "$ref": "#/definitions/fixedDateCondition" },
            { "$ref": "#/definitions/dateRangeCondition" },
            { "$ref": "#/definitions/weekdayCondition" },
            { "$ref": "#/definitions/holidayCondition" }
          ]
        }
      }
    },

    "weekOfCondition": {
      "type": "object",
      "required": ["date", "offset"],
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "offset": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 2,
          "maxItems": 2
        }
      }
    },

    "fixedDateCondition": {
      "type": "object",
      "required": ["month", "day"],
      "properties": {
        "month": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31
        }
      }
    },

    "dateRangeCondition": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": {
          "type": "string",
          "format": "date"
        },
        "end": {
          "type": "string",
          "format": "date"
        }
      }
    },

    "weekdayCondition": {
      "type": "string",
      "enum": [
        "MONDAY",
        "TUESDAY",
        "WEDNESDAY",
        "THURSDAY",
        "FRIDAY",
        "SATURDAY",
        "SUNDAY"
      ]
    },

    "holidayCondition": {
      "type": "object",
      "required": ["holidayType"],
      "properties": {
        "holidayType": {
          "type": "string",
          "enum": ["NATIONAL"]
        }
      }
    },

    "effect": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["CANCEL", "MOVE"]
        },
        "params": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "MOVE" } }
          },
          "then": {
            "required": ["params"],
            "properties": {
              "params": {
                "type": "object",
                "required": ["newTime"],
                "properties": {
                  "newTime": {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):([0-5]\\d)$"
                  }
                }
              }
            }
          }
        }
      ]
    }

  }
}